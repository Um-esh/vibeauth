# Instant Persona and Communication Transformer Environment Configuration
# Copy this file to .env to customize settings

SECRET_KEY=instant-persona-local-dev-secret-key
FLASK_DEBUG=false
HOST=127.0.0.1
PORT=5000

# Offline Mode: set to true after downloading models using 'python backend/scripts/download_models.py'
OFFLINE_MODE=true

# Execution hardware: 'cpu', 'cuda', or 'auto'
DEVICE=cpu

# Model identifiers and paths
GENERATION_MODEL_NAME=google/flan-t5-small
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2

# Safety and performance constraints
MAX_INPUT_CHARS=2500
MAX_INPUT_WORDS=500
MAX_GENERATION_TOKENS=256
MAX_REGENERATION_ATTEMPTS=1
